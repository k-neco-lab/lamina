<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>K Lab</Authors>
    <Company>K Lab</Company>
    <Product>Lamina</Product>
    <Copyright>Copyright (c) 2026 K Lab</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/k-neco-lab/lamina</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/k-neco-lab/lamina</PackageProjectUrl>
    <PackageTags>openvr;steamvr;vr;overlay;direct2d;ui;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
